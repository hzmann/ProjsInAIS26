      "cell_type": "code",
      "source": [
        "# helper functions for output formatting\n",
        "\n",
        "# function to display the value function in grid form\n",
        "def print_value_function(V, shape=(4, 4)):\n",
        "    print(\"Value Function:\")\n",
        "    # reshape flat value array into a 4x4 grid and round for readability\n",
        "    print(np.round(V.reshape(shape), 4))\n",
        "\n",
        "# function to display the policy in a readable grid with arrows\n",
        "def print_policy(policy, env, shape=(4, 4)):\n",
        "    arrows = {\n",
        "        0: \"←\",\n",
        "        1: \"↓\",\n",
        "        2: \"→\",\n",
        "        3: \"↑\"\n",
        "    }\n",
        "\n",
        "    # get environment map layout for reference so we can preserve special tiles\n",
        "    desc = env.unwrapped.desc.astype(str)\n",
        "    # will store formatted policy symbols\n",
        "    policy_grid = []\n",
        "\n",
        "    # convert the 1D policy array into a 2D grid\n",
        "    for s in range(len(policy)):\n",
        "        # get row and column index from flattened state index\n",
        "        row = s // shape[1]\n",
        "        col = s % shape[1]\n",
        "        # check tile type\n",
        "        tile = desc[row][col]\n",
        "\n",
        "        # preserve special tiles (hole and goal) instead of showing arrows\n",
        "        if tile == \"H\":\n",
        "            policy_grid.append(\"H\")\n",
        "        elif tile == \"G\":\n",
        "            policy_grid.append(\"G\")\n",
        "        # otherwise show action\n",
        "        else:\n",
        "            policy_grid.append(arrows[policy[s]])\n",
        "\n",
        "    # reshape for printing\n",
        "    policy_grid = np.array(policy_grid).reshape(shape)\n",
        "\n",
        "    print(\"Policy:\")\n",
        "    for row in policy_grid:\n",
        "        print(\" \".join(row))\n"
      ],
