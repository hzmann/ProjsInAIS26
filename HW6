        "**value iteration**\n",
        "<br>\n",
        "<br>\n",
        "$ V_{k+1}(s) = max_a \\sum_{s'}P(s'\\mid s,a)[R(s,a,s') + \\gamma V(s')]$\n",
        "<br>\n",
        "<br>\n",
        "evaluate all actions at each state and keep the one with largest expected return"
      ],
      "metadata": {
        "id": "9oapEQCplWmw"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def value_iteration(env, gamma=0.95, theta=1e-10):\n",
        "    \"\"\"\n",
        "    Run value iteration for a discrete Gymnasium environment.\n",
        "\n",
        "    Parameters:\n",
        "        env   : environment with env.unwrapped.P transition dictionary\n",
        "        gamma : discount factor\n",
        "        theta : convergence threshold\n",
        "\n",
        "    Returns:\n",
        "        V      : optimal value function\n",
        "        policy : greedy policy derived from V\n",
        "    \"\"\"\n",
        "    # access transition probability model of the MDP\n",
        "    P = env.unwrapped.P\n",
        "    # get num of discrete states and actions\n",
        "    n_states = env.observation_space.n\n",
        "    n_actions = env.action_space.n\n",
        "\n",
        "    # initialize value function V(s) = 0 for all states\n",
        "    V = np.zeros(n_states)\n",
        "\n",
        "    # main value iteration loop to repeatedly update V until convergence\n",
        "    while True:\n",
        "        # start a new iteration of value updates\n",
        "        delta = 0 # will track the largest change in the value function across all states to check for convergence\n",
        "        for s in range(n_states):\n",
        "            # store previous value to measure how much it changes\n",
        "            old_v = V[s]\n",
        "            # will store the value of each possible action from state s\n",
        "            action_values = []\n",
        "\n",
        "            for a in range(n_actions):\n",
        "                # Q(s,a): expected value of taking action a in state s\n",
        "                q_sa = 0\n",
        "                # loop over all possible outcomes of taking action a in state s\n",
        "                for prob, next_state, reward, done in P[s][a]:\n",
        "                    # Bellam update: expected rewared + discounted future value\n",
        "                    q_sa += prob * (reward + gamma * V[next_state])\n",
        "                # store the computed value for this action\n",
        "                action_values.append(q_sa)\n",
        "            # update V(s) to the optimal action value\n",
        "            V[s] = max(action_values)\n",
        "            # update delta to track the largest change in value across all states\n",
        "            delta = max(delta, abs(old_v - V[s]))\n",
        "        # if value function has stopped changing significantly, it's converged\n",
        "        if delta < theta:\n",
        "            break\n",
        "\n",
        "    # derive optimal greedy policy from converged value function\n",
        "    policy = np.zeros(n_states, dtype=int)\n",
        "\n",
        "    # loop through each state in the environment to determine best action for each one\n",
        "    for s in range(n_states):\n",
        "        # list to store Q(s,a) of each possible outcome from this state\n",
        "        action_values = []\n",
        "        # loop through all possible actions the agent can take from state s\n",
        "        for a in range(n_actions):\n",
        "            # initialize Q(s,a): expected val of taking action a in state s\n",
        "            q_sa = 0\n",
        "            # loop over all possible outcomes of taking action a in state s\n",
        "            for prob, next_state, reward, done in P[s][a]:\n",
        "                # apply Bellman\n",
        "                q_sa += prob * (reward + gamma * V[next_state])\n",
        "            # store computed value of the action\n",
        "            action_values.append(q_sa)\n",
        "        # choose action with highest value/best expected return\n",
        "        policy[s] = np.argmax(action_values)\n",
        "\n",
        "    # V: final value function of how good each state is\n",
        "    # policy: optimal action to take in each state\n",
        "    return V, policy"
      ],
