    {
      "cell_type": "code",
      "source": [
        "# build the environment\n",
        "\n",
        "import numpy as np\n",
        "import gymnasium as gym\n",
        "\n",
        "# create FrozenLake environment: 4x4 keeps state space small at 16 states so results are easy to interpret and visualize\n",
        "# is_slippery makes transitions deterministic/each action leads to a predictable next state\n",
        "env = gym.make(\"FrozenLake-v1\", map_name=\"4x4\", is_slippery=False)\n",
        "\n",
        "n_states = env.observation_space.n # number of discrete states\n",
        "n_actions = env.action_space.n # number of discrete actions\n",
        "\n",
        "# map action indices to human-readable directions\n",
        "actions = {\n",
        "    0: \"Left\",\n",
        "    1: \"Down\",\n",
        "    2: \"Right\",\n",
        "    3: \"Up\"\n",
        "}"
